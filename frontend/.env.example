# All optional. Without them the app uses Stellar Testnet and the contract IDs
# in src/config/testnet.json (written by scripts/deploy_testnet.sh).
# Copy to .env.local to override.

# AnchorSwap contract ID (C...)
# NEXT_PUBLIC_ANCHORSWAP_CONTRACT=

# Network endpoints
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Never put secret keys (S...) in this file. The app never needs one.
